# Conexión a PostgreSQL para Autos Colombia.
#
# Uso:
#   1. Copia este archivo a .env   (cp .env.example .env)
#   2. Completa usuario, clave y nombre de la base.
#   3. Ejecuta ./run-local.sh
#
# .env está en .gitignore: nunca se sube al repositorio.
# El driver ya está en backend/requirements.txt (psycopg).

DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@127.0.0.1:5432/autos_colombia_app
