# Variables for docker-compose.yml in Dokploy.
# Set real values in Dokploy; do not commit passwords.

# External PostgreSQL connection (Neon, for example).
# Use the Compose backend service only; do not use localhost.
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE_URL_ENCODED@HOST:5432/BASE?sslmode=require

# Public frontend origin allowed to call the separate API domain.
CORS_ORIGINS=https://iudigital.zyvra.lat
