# Variables for docker-compose.yml in Dokploy.
# Set real values in Dokploy; do not commit passwords.
POSTGRES_DB=autos_colombia
POSTGRES_USER=autos_colombia
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# The hostname is the Compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://autos_colombia:REPLACE_WITH_A_URL_ENCODED_PASSWORD@db:5432/autos_colombia

# Leave empty when frontend and API use the same public domain.
# For a separate API domain, use a comma-separated list of origins.
CORS_ORIGINS=
